# Copy to .env (never committed) and fill in.
# OpenAI (paid API balance) - preferred when set. Spend is capped by AGENT_BUDGET_USD.
OPENAI_API_KEY=
# Gemini (free tier) - main model if no OpenAI key; otherwise a helper for Google search and YouTube videos.
GEMINI_API_KEY=
# Optional overrides
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-6.1-sol
# AGENT_BUDGET_USD=5
# AGENT_REASONING_EFFORT=medium
# HF username used for submission (otherwise taken from `hf auth whoami`)
# HF_USERNAME=
